include README.md README.en.md LICENSE requirements-runtime.lock
recursive-include assets *.svg
recursive-include skills *.md *.yaml
recursive-include docs *.md
recursive-include scripts *.py *.sh
recursive-include tests *.py *.ts *.js *.cpp *.hpp *.kt *.json *.md CMakeLists.txt
prune evidence
prune tools
global-exclude __pycache__ *.pyc *.jar
prune tests/framework-fixtures/next/node_modules
prune tests/framework-fixtures/next/.next
prune tests/framework-fixtures/gradle/.gradle
prune tests/framework-fixtures/gradle/app/build
prune tests/framework-fixtures/gradle/shared/build
recursive-include tests/framework-fixtures *.gradle *.kts *.java *.xml *.prisma *.sql
prune tests/framework-fixtures/android/.gradle
prune tests/framework-fixtures/android/app/build
prune tests/framework-fixtures/android/build
recursive-include tests/framework-fixtures *.properties
