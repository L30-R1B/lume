-inline long long retry_delay(int attempt, long long base, long long cap) { throw std::logic_error("implement backoff"); }
+inline long long retry_delay(int attempt, long long base, long long cap) {
+    if (base == 0 || cap == 0) return 0;
+    long long delay = std::min(base, cap);
+    for (int i = 0; i < attempt && delay < cap; ++i) {
+        if (delay > cap / 2) return cap;
+        delay *= 2;
+    }
+    return delay;
+}
