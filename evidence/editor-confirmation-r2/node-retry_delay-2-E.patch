-exports.retry_delay = function(attempt, base, cap) { throw new Error("implement backoff"); };
+exports.retry_delay = function(attempt, base, cap) {
+  if (base === 0 || cap === 0) return 0;
+  let delay = Math.min(base, cap);
+  for (let i = 0; i < attempt && delay < cap; i++) {
+    if (delay >= cap / 2) return cap;
+    delay *= 2;
+  }
+  return delay;
+};
