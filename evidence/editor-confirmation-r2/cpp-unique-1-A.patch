-inline std::vector<int> unique(std::vector<int> values) { return values; }
+inline std::vector<int> unique(const std::vector<int>& values) {
+    std::unordered_set<int> seen;
+    std::vector<int> result;
+    for (int value : values) {
+        if (seen.insert(value).second) {
+            result.push_back(value);
+        }
+    }
+    return result;
