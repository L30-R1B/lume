+inline int parse_port(std::string text) {
+    if (text.empty()) return -1;
+    int port = 0;
+    for (char digit : text) {
+        if (digit < '0' || digit > '9') return -1;
+        if (port > (65535 - (digit - '0')) / 10) return -1;
+        port = port * 10 + (digit - '0');
+    }
+    return port == 0 ? -1 : port;
+}
