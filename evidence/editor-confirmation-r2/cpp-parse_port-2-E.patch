+inline int parse_port(std::string text) {
+    if (text.empty()) return -1;
+    int value = 0;
+    for (unsigned char c : text) {
+        if (c < 0x30 || c > 0x39) return -1;
+        int digit = c - 0x30;
+        if (value > (65535 - digit) / 10) return -1;
+        value = value * 10 + digit;
+    }
+    return value == 0 ? -1 : value;
+}
