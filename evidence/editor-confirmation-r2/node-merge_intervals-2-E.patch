-exports.merge_intervals = function(intervals) { throw new Error("implement interval merging"); };
+exports.merge_intervals = function(intervals) {
+  const sorted = intervals.map(interval => interval.slice())
+    .sort((a, b) => a[0] - b[0] || a[1] - b[1]);
+  const merged = [];
+  for (const interval of sorted) {
+    const last = merged[merged.length - 1];
+    if (last && interval[0] <= last[1]) {
+      last[1] = Math.max(last[1], interval[1]);
+    } else {
+      merged.push(interval);
+    }
+  }
+  return merged;
+};
