+inline int parse_port(std::string text) {
+    if (text.empty()) return -1;
+    int port = 0;
+    for (unsigned char c : text) {
+        if (c < '0' || c > '9') return -1;
+        int digit = c - '0';
+        if (port > (65535 - digit) / 10) return -1;
+        port = port * 10 + digit;
+    }
+    return port == 0 ? -1 : port;
+}
