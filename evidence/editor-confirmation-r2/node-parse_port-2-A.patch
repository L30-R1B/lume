-exports.parse_port = function(text) { return Number(text); };
+exports.parse_port = function(text) {
+  if (typeof text !== "string" || text.length === 0 || /[^0-9]/.test(text)) {
+    return null;
+  }
+  const port = Number(text);
+  return port >= 1 && port <= 65535 ? port : null;
+};
