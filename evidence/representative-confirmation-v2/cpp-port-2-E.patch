+inline int parsePort(const std::string& s) {
+    if (s.empty()) return -1;
+    unsigned int port = 0;
+    for (char c : s) {
+        if (c < '0' || c > '9') return -1;
+        unsigned int digit = static_cast<unsigned int>(c - '0');
+        if (port > (65535u - digit) / 10u) return -1;
+        port = port * 10u + digit;
+    }
+    return port == 0 ? -1 : static_cast<int>(port);
+}
