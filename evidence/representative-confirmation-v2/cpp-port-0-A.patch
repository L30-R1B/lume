+inline int parsePort(const std::string& s) {
+    if (s.empty()) return -1;
+    int port = 0;
+    for (char c : s) {
+        if (c < '0' || c > '9') return -1;
+        int digit = c - '0';
+        if (port > (65535 - digit) / 10) return -1;
+        port = port * 10 + digit;
+    }
+    return port == 0 ? -1 : port;
+}
